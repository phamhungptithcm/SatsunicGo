+
+/* PAGES-007: public editorial and support surfaces. */
+.postsPage,
+.supportPage {
+  max-width: 1164px;
+  padding-top: 64px;
+  padding-bottom: 72px;
+}
+.editorialEyebrow {
+  display: block;
+  color: var(--blue);
+  font-size: 11px;
+  font-weight: 650;
+  letter-spacing: 1.6px;
+  text-transform: uppercase;
+}
+.postsHeading {
+  position: relative;
+  margin-bottom: 36px;
+  padding-left: 24px;
+  border-left: 3px solid var(--blue);
+}
+.postsHeading h1,
+.supportIntro h1 {
+  font-size: clamp(36px, 4vw, 54px);
+  line-height: 1.14;
+  font-weight: 650;
+  letter-spacing: -2px;
+  margin: 16px 0;
+}
+.postsHeading h1 span,
+.supportIntro h1 span {
+  color: var(--blue);
+}
+.postsHeading p,
+.supportIntro > p {
+  max-width: 450px;
+  color: #647087;
+  font-size: 15px;
+  line-height: 1.8;
+}
+.postsEmpty {
+  display: grid;
+  grid-template-columns: 240px 1fr;
+  align-items: center;
+  gap: 44px;
+  border: 1px solid var(--border);
+  border-radius: 20px;
+  padding: 44px 56px;
+  background: linear-gradient(115deg, #f4f6ff, #fafbff 40%, #fff 75%);
+}
+.postsIllustration {
+  color: var(--blue);
+  padding: 20px;
+  border-radius: 50%;
+  background: #e9eeff;
+  aspect-ratio: 1;
+  display: grid;
+  place-items: center;
+}
+.postsIllustration svg {
+  width: 100%;
+  max-width: 200px;
+}
+.postsEmptyCopy h2 {
+  font-size: 25px;
