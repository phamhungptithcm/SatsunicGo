+.postsShortcuts > a {
+  display: flex;
+  align-items: center;
+  gap: 18px;
+  padding: 20px 4px;
+  border-bottom: 1px solid var(--border);
+}
+.shortcutNumber {
+  color: #647087;
+  font-size: 12px;
+  font-variant-numeric: tabular-nums;
+}
+.postsShortcuts strong {
+  display: block;
+  font-size: 14px;
+  font-weight: 600;
