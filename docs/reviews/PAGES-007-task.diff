+  letter-spacing: -0.7px;
+  line-height: 1.35;
+  margin: 12px 0;
+}
+.postsEmptyCopy p {
+  max-width: 470px;
+  color: #647087;
+  font-size: 14px;
+  line-height: 1.8;
+  margin: 0 0 24px;
+}
+.postsPrimary {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 24px;
+  border-radius: 10px;
+  font-size: 13px;
+  min-height: 46px;
+  padding: 12px 20px;
+}
+.postsShortcuts {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 32px;
+  margin-top: 28px;
